# Offline demo mode (default): runs from the pinned snapshot, no network, no API key needed.
OFFLINE=1
LIVE=0

# Only needed for the live "new problem" path (agent writes a check with an OpenAI model).
OPENAI_API_KEY=your-openai-api-key

# Required by SEC EDGAR fair-access policy when OFFLINE=0 LIVE=1.
EDGAR_UA=Your Name your.email@example.com
